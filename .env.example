# MySQL 8.0: create a dedicated database and user first (see README.md).
DEVOPS_DB_PROVIDER=mysql
DEVOPS_MYSQL_CONNECTION_STRING="Server=127.0.0.1;Port=3306;Database=mini_devops;User ID=mini_devops;Password=replace-with-your-password;Character Set=utf8mb4"
DEVOPS_URL=http://127.0.0.1:3220
# For a zero-configuration local preview, omit .env (defaults to SQLite),
# or set DEVOPS_DB_PROVIDER=sqlite and DEVOPS_DB_PATH=data/devops.db.
# Remote deployment:
# DEVOPS_URL=http://0.0.0.0:3220
# DEVOPS_PUBLIC_URL=https://devops.example.com
# DEVOPS_SETUP_TOKEN=your-long-random-first-run-token
